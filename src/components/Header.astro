---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="external-links">
			<HeaderLink href="/about-botfiction">What is botfiction?</HeaderLink>
			<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M9.884 0.229a8 8 0 1 0 5.887 5.887 6.5 6.5 0 0 1-5.887-5.887zM8.75 1.75a7.25 7.25 0 1 0 5.5 5.5A7.25 7.25 0 0 1 8.75 1.75z"
					></path>
					<path
						fill="currentColor"
						d="M8.75 1.75a7.25 7.25 0 1 0 5.5 5.5A7.25 7.25 0 0 1 8.75 1.75zM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm0 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
					></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	const root = document.documentElement;
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const current = root.dataset.theme ?? (prefersDark ? 'dark' : 'light');
			const next = current === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {
				/* no persistence — theme applies for this page only */
			}
		});
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black)); /* near-black on light, near-white on dark surface */
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.external-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5em;
		margin-left: 0.25em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	@media (max-width: 720px) {
		.external-links a {
			display: none;
		}
	}
</style>
