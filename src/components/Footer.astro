---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
	<nav class="site-links">
		<a href="/novels/">Serials</a>
		<a href="/">Latest Updates</a>
		<a href="/blog">Notes</a>
		<a href="/about">About</a>
		<a href="/about-botfiction">What is botfiction?</a>
		<a href="/rss.xml">Chapters RSS</a>
	</nav>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.site-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25em 1em;
		margin-top: 1em;
	}
	.site-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.site-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
